rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras Globais
    match /{document=**} {
      allow read, write: if false; // Por padrão tudo bloqueado
    }

    // Regras para Grupos
    match /groups/{groupId} {
      // Leitura: Apenas membros do grupo
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      
      // Criação: Qualquer usuário autenticado pode criar, desde que se coloque como admin e membro
      allow create: if request.auth != null 
                    && request.resource.data.adminId == request.auth.uid
                    && request.auth.uid in request.resource.data.members;
                    
      // Atualização: Apenas o admin pode alterar os dados do grupo via cliente
      // (A adição de novos membros por link será feita pelo backend/API admin)
      allow update: if request.auth != null && resource.data.adminId == request.auth.uid;
      
      allow delete: if request.auth != null && resource.data.adminId == request.auth.uid;
    }
  }
}
