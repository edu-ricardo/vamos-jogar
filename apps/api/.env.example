PORT=3001

# PocketBase (superusuário criado pelo próprio container do PocketBase com os mesmos valores)
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Ludopedia (https://ludopedia.com.br/api/documentacao.html) e BoardGameGeek
LUDOPEDIA_ACCESS_TOKEN=
BGG_API_KEY=

# Notificações (Web Push). Gere uma vez com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelos serviços de push (mailto:voce@exemplo.com ou o endereço do app)
VAPID_SUBJECT=

# Endereço público do app
FRONTEND_URL=http://localhost:3080

# Painel de admin: e-mails (separados por vírgula) que são sempre admins do app
APP_ADMIN_EMAILS=

# Só para o script de backup do Firebase (npm run backup)
FIREBASE_SERVICE_ACCOUNT_KEY=
