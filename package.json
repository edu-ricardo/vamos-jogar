{
  "name": "vamos-jogar-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start": "npm --workspace=api run start",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-vamos-jogar \"vitest run --dir tests\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^8.0.0",
    "firebase": "^12.19.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
