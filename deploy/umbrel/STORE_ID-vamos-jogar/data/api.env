# Preencha no Umbrel e reinicie o app. Este arquivo fica em
# ~/umbrel/app-data/STORE_ID-vamos-jogar/data/api.env — guarde uma cópia fora do Umbrel.
LUDOPEDIA_ACCESS_TOKEN=
BGG_API_KEY=
# JSON da conta de serviço do Firebase em uma única linha
FIREBASE_SERVICE_ACCOUNT_KEY=
CRON_SECRET=
RESEND_API_KEY=
# Endereço público do app (link dos e-mails de lembrete)
FRONTEND_URL=
